;a.firstChild;)b.parentNode.insertBefore(a.firstChild,b);b.parentNode.removeChild(b)};$RS("S:2","P:2")</script><script>self.__next_f.push([1,"29:I[22575,[\"2545\",\"static/chunks/c16f53c3-9b3a46e88b4dee5f.js\",\"9656\",\"static/chunks/9656-c5ff719ac02def2f.js\",\"5610\",\"static/chunks/5610-94b9e78259eff88d.js\",\"2075\",\"static/chunks/2075-0a83d8583b765f84.js\",\"5552\",\"static/chunks/5552-b31ce21700449e72.js\",\"5136\",\"static/chunks/5136-deaf8d731badd9dd.js\",\"7157\",\"static/chunks/app/%5Blocale%5D/%5Bauthority%5D/contest/view/%5Bcontest_id%5D/page-8058cc2e6115856b.js\"],\"ContestView\"]\n2a:T1dd7,"])</script><script>self.__next_f.push([1,"\u003cp\u003eIlmiy faoliyatga oid davlat dasturlari doirasida bajariladigan amaliy tadqiqot va innovatsion loyihalarni qabul qilish uchun \u0026ldquo;Olima ayollar\u0026rdquo; tanlovi eʼlon qilinmoqda.\u003c/p\u003e\r\n\r\n\u003cp\u003eTanlov Oila va xotin-qizlar qoʻmitasi bilan birgalikda Oʻzbekiston Respublikasi Prezidentining \u0026ldquo;Oila va xotin-qizlarni tizimli qoʻllab-quvvatlashga doir ishlarni yanada jadallashtirish chora-tadbirlari toʻgʻrisida\u0026rdquo; 2022-yil 7-martdagi PF-87-son Farmonining 5.2-bandiga asosan ilmiy-tadqiqot ishlarining ustuvor yoʻnalishlari doirasida tashkil etilmoqda.\u003c/p\u003e\r\n\r\n\u003cp\u003eMazkur tanlov Oʻzbekiston Respublikasi Vazirlar Mahkamasining \u0026ldquo;Ilmiy-tadqiqot va innovatsion faoliyatni rivojlantirishning normativ-huquqiy bazasini yanada takomillashtirish chora-tadbirlari toʻgʻrisida\u0026rdquo; 2020-yil 9-martdagi 133-son qarorida belgilangan talablarga muvofiq quyidagi fan yoʻnalishlari boʻyicha eʼlon qilinadi:\u003c/p\u003e\r\n\r\n\u003col\u003e\r\n\t\u003cli\u003eArxitektura, qurilish, dizayn va shaharsozlik fanlari\u003c/li\u003e\r\n\t\u003cli\u003eAxborotlashtirish va axborot-kommunikatsiya texnologiyalarini rivojlantirish fanlari\u003c/li\u003e\r\n\t\u003cli\u003eBiologiya va biotexnologiya fanlari\u003c/li\u003e\r\n\t\u003cli\u003eEkologiya, atrof-muhitni muhofaza qilish va iqlim oʻzgarishi\u003c/li\u003e\r\n\t\u003cli\u003eFarmakologiya va farmatsevtika fanlari\u003c/li\u003e\r\n\t\u003cli\u003eFilologiya va ijtimoiy fanlar\u003c/li\u003e\r\n\t\u003cli\u003eHuquq fanlari\u003c/li\u003e\r\n\t\u003cli\u003eIqtisodiyot fanlari\u003c/li\u003e\r\n\t\u003cli\u003eKimyo fanlari, kimyoviy texnologiya va nanotexnologiyalar\u003c/li\u003e\r\n\t\u003cli\u003eMatematika, fizika va mexanika fanlari\u003c/li\u003e\r\n\t\u003cli\u003eOʻrmon xoʻjaligi, tuproqshunoslik va oʻsimliklarni himoya qilish fanlari\u003c/li\u003e\r\n\t\u003cli\u003ePedagogika va psixologiya fanlari\u003c/li\u003e\r\n\t\u003cli\u003eQishloq xoʻjaligi fanlari\u003c/li\u003e\r\n\t\u003cli\u003eTarix va arxeologiya fanlari\u003c/li\u003e\r\n\t\u003cli\u003eTexnika fanlari\u003c/li\u003e\r\n\t\u003cli\u003eTibbiyot fanlari\u003c/li\u003e\r\n\t\u003cli\u003eVeterinariya va chorvachilik fanlari\u003c/li\u003e\r\n\t\u003cli\u003eYer toʻgʻrisidagi fanlar\u003c/li\u003e\r\n\u003c/ol\u003e\r\n\r\n\u003cp\u003e\u003cstrong\u003eTanlov doirasida ilmiy ekspertiza natijalariga koʻra fan yoʻnalishlari kesimida eng yuqori ball toʻplagan 1 ta ilmiy loyiha moliyalashtirishga tavsiya etiladi.\u003c/strong\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003eLoyiha taqdim qilinganda loyiha rahbari oʻz loyihasi tadqiqot yoʻnalishidan kelib chiqib, Oliy taʼlim, fan va innovatsiyalar vazirligi huzuridagi Ilmiy-texnik kengash yoʻnalishini tanlashi va shu yoʻnalish boʻyicha taqdim qilishi lozim.\u003c/p\u003e\r\n\r\n\u003cp\u003e\u003cstrong\u003eTanlovning asosiy maqsadi\u003c/strong\u003e \u0026ndash; respublikamizda xotin-qizlarni ilm-fanga keng jalb qilish, fan-taʼlim va iqtisodiyotning turli tarmoq va sohalarida ilmiy faoliyat bilan shugʻullanayotgan xotin-qizlarning yangi gʻoya va ishlanmalarini har tomonlama qoʻllab-quvvatlash va ragʻbatlantirish, tashabbuskor amaliy tadqiqotlar va innovatsion loyihalar natijalari boʻyicha iqtisodiyot tarmoqlari va ijtimoiy sohaning mavjud muammolari, real ehtiyojlari hamda hududiy muammolarni hal etishga qaratilgan ilmiy hajmdor mahsulotlar va innovatsion texnologiyalarni yaratishdan iborat.\u003c/p\u003e\r\n\r\n\u003cp\u003e\u003cstrong\u003eTanlovga taqdim etiladigan ilmiy loyihalar \u003c/strong\u003edavlat ilmiy dasturlarining yagona intellektual elektron platformasi (\u003ca href=\"http://www.loyiha.ilmiy.uz/\" title=\"http://www.loyiha.ilmiy.uz/\"\u003e\u003cstrong\u003eloyiha.ilmiy.uz\u003c/strong\u003e\u003c/a\u003e) orqali \u003cstrong\u003e2026-yil 17-martdan\u003c/strong\u003e \u003cstrong\u003e2026-yil 17-aprel soat 23:55 ga qadar faqat elektron shaklda qabul qilinadi.\u003c/strong\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003e\u003ca href=\"http://mininnovation.uz/uploads/mininno/tanlov/Tanlov_shartlari2021.pdf\" title=\"http://mininnovation.uz/uploads/mininno/tanlov/Tanlov_shartlari2021.pdf\"\u003e\u003cstrong\u003e\u003cem\u003eTanlov shartlari.\u003c/em\u003e\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003e1.\u0026nbsp;Tanlovda ilmiy-tadqiqotlar oʻtkazish uchun imkoniyati va salohiyati \u003cstrong\u003emavjud ilmiy faoliyat subyektlari ishtirok etishi mumkin\u003c/strong\u003e.\u003c/p\u003e\r\n\r\n\u003cp\u003e2.\u0026nbsp;Loyiha rahbari tomonidan tanlovga faqat bitta loyiha taqdim etilishi mumkin.\u003c/p\u003e\r\n\r\n\u003cp\u003e3.\u0026nbsp;Ilmiy loyihalar boʻyicha ijrochi tashkilot Ilmiy (ilmiy-texnik) kengashi majlisining bayonidan koʻchirmada va bajarilishi rejalashtirilgan ilmiy loyiha yakunida qoʻlga kiritiladigan muhim ilmiy natija \u003cem\u003e(yakuniy mahsulot, yangi ishlanma, texnologiya) \u003c/em\u003eqayd etilishi (asoslab berilishi) lozim.\u003c/p\u003e\r\n\r\n\u003cp\u003eTaqdim etilgan loyihalardagi maʼlumotlarning haqqoniyligi \u0026nbsp;va ishonchliligi hamda tanlov gʻoliblari tomonidan ilmiy-texnik loyihalarning natijadorligi, tijoratlashtirish darajasi, tanlov dasturlari vazifalarida belgilangan, kutilayotgan natijalarni toʻla va oʻz vaqtida sifatli bajarilishiga ilmiy loyiha rahbarlari, ilmiy loyihani bajaruvchi tashkilot rahbarlari va tegishli yuqori turuvchi tashkilotlarning masʼul xodimlari javobgar hisoblanadilar.\u003c/p\u003e\r\n\r\n\u003cp\u003e4.\u0026nbsp;Tanlovga bajarilishi bir yil davrga moʻljallangan umumiy qiymati 2000 BHM dan oshmagan loyiha talabnomalari qabul qilinadi. Mazkur shartlarga mos boʻlmagan loyiha talabnomalari dastlabki texnik ekspertizadan oʻtkazilmaydi va koʻrib chiqilmaydi.\u003c/p\u003e\r\n\r\n\u003cp\u003e5.\u0026nbsp;Loyihani amalga oshirish boʻyicha ilmiy jamoaning oʻrtacha yoshi, qoida tariqasida \u003cstrong\u003e45 yoshdan oshmasligi kerak\u003c/strong\u003e \u003cem\u003e(Ilmiy jamoaning oʻrtacha yoshi barcha ijrochilarning yoshini oʻrtacha arifmetik qiymati sifatida hisoblanadi)\u003c/em\u003e.\u003c/p\u003e\r\n\r\n\u003cp\u003e6. Eʼlon qilingan mavzularga taqdim etiladigan ilmiy loyihalar tegishli vazirlik va idoralarning qoʻllab-quvvatlash xati mavjud boʻlganida qabul qilinadi.\u003c/p\u003e\r\n\r\n\u003cp\u003e7.\u0026nbsp;Ilmiy loyiha maʼlumotlari Davlat ilmiy dasturlarining yagona intellektual elektron platformasi (loyiha.ilmiy.uz) orqali davlat tilida (lotin alifbosiga asoslangan oʻzbek yozuvida) kiritiladi va ijrochi tashkilotning masʼul rahbari tomonidan tasdiqlanadi.\u003c/p\u003e\r\n\r\n\u003cp\u003e8.\u0026nbsp;Tanlovga taqdim etiladigan ilmiy loyihalar yakunida axborot tizimini ishlab chiqish, kompleks foydalanishga asoslangan dasturiy mahsulotlar, veb platformalar, mobil ilovalar yaratishga qaratilgan boʻlsa quyidagilar talab qilinadi:\u003c/p\u003e\r\n\r\n\u003cp\u003eyaratiladigan dasturiy mahsulot uchun Adliya vazirligi huzuridagi Intellektual mulk agentligidan oʻrnatilgan tartibda roʻyxatdan oʻtkazish va EHM uchun yaratilgan dastur guvohnomasini olish vazifasi loyiha talabnomasida aks etishi;\u003c/p\u003e\r\n\r\n\u003cp\u003edasturiy mahsulotning loyiha yakunlangandan soʻng, uzluksiz ishlashi va zarur hollarda maʼlumotlarni yangilab borish;\u003c/p\u003e\r\n\r\n\u003cp\u003eloyiha talabnomasida kamida uch yillik \u0026ldquo;hosting\u0026rdquo; va \u0026ldquo;domen\u0026rdquo; (mobil ilova boʻlsa, mobil ilovalar doʻkoniga joylashtirish) xarajatlarini \u0026ldquo;loyihaning boshqa shu kabi xarajatlar\u0026rdquo; bandiga kiritish.\u003c/p\u003e\r\n\r\n\u003cp\u003e\u003cstrong\u003eEslatma: \u003c/strong\u003eTanlovga taqdim etilgan \u003cstrong\u003eloyihalarning har bir bosqichda koʻrib chiqish natijalari\u003c/strong\u003e toʻgʻrisidagi maʼlumotlar loyiha rahbarlarining Davlat ilmiy dasturlarining yagona intellektual elektron platformasidagi \u003cstrong\u003e(loyiha.ilmiy.uz) \u003c/strong\u003eshaxsiy kabinetlarida \u003cstrong\u003etaqdim etib boriladi.\u003c/strong\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003e\u003cstrong\u003eTanlovga taqdim etiladigan loyiha talabnomalari faqat ilmiy va innovatsion faoliyat bilan shugʻullanuvchi (ScienceID) identifikatsiyasiga ega foydalanuvchilar tomonidan davlat ilmiy dasturlarining yagona intellektual elektron platformasi \u003c/strong\u003e\u003cstrong\u003e(loyiha.ilmiy.uz) \u003c/strong\u003e\u003cstrong\u003eorqali\u0026nbsp; qabul qilinadi. \u0026ldquo;ScienceID\u0026rdquo; dan roʻyxatdan oʻtish \u003c/strong\u003e\u003cstrong\u003eid.ilmiy.uz \u003c/strong\u003e\u003cstrong\u003etizimi orqali amalga oshiriladi. Loyihaning ijrochilari yoki loyiha rahbari boʻlmagan shaxslar tomonidan taqdim etilgan, ijrochi tashkilotning masʼul rahbari tomonidan tasdiqlanmagan loyiha talabnomalari tanlovga qabul qilinmaydi.\u003c/strong\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003e\u003cstrong\u003eIlmiy loyihalarni shakllantirish bilan bogʻliq masalalar boʻyicha Innovatsion rivojlanish agentligi masʼul xodimlari: +99871 203-32-23 (211, 219, 413, 425, 246)\u003c/strong\u003e\u003cstrong\u003e\u003cem\u003e.\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\r\n"])</script><script>self.__next_f.push([1,"6:[\"$\",\"$L29\",null,{\"view\":{\"data\":{\"id\":143651,\"age_limit\":18,\"category_code\":\"innovat