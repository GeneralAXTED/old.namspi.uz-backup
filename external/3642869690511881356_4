003e\u003col\u003e\u003cli\u003eNomzod faoliyat ko‘rsatayotgan muassasa yo‘llanma xati.\u003c/li\u003e\u003cli\u003eIlmiy-tadqiqot loyihasi (loyiha kalendar rejasi, loyiha xarajatlar smetasi).\u003c/li\u003e\u003cli\u003eNomzodlarning loyihalari ular faoliyat yuritayotgan muassasalarning \u003cstrong\u003eilmiy yoki ilmiy-texnik kengashlari tomonidan tasdiqlangan\u003c/strong\u003e bo‘lishi lozim.\u003c/li\u003e\u003cli\u003eLoyihaga nomzodning \u003cstrong\u003ema’lumotnoma-obyektivkasi (anketa)\u003c/strong\u003e ilova qilinadi.\u003c/li\u003e\u003cli\u003eNashr etilgan ilmiy ishlar ro‘yxati \u003cstrong\u003enomzodning ilmiy rahbari tomonidan tasdiqlanadi\u003c/strong\u003e.\u003c/li\u003e\u003cli\u003eQabul qiluvchi tashkilotning rozilik xati \u003cstrong\u003eInnovatsion rivojlanish agentligi nomiga\u003c/strong\u003e (tashkilot rasmiy blankida hamda tashkilot birinchi rahbari tomonidan imzolangan bo‘lishi shart).\u003c/li\u003e\u003cli\u003eIlmiy loyihaning taqdimoti (\u003cstrong\u003e10 ta slayddan oshmagan\u003c/strong\u003e).\u003c/li\u003e\u003c/ol\u003e\u003cp\u003e📌 Taqdim etilgan ilmiy loyihalardagi ma’lumotlarning haqqoniyligi va ishonchliligi, tanlov dasturlari vazifalarida belgilangan kutilayotgan natijalarni to‘la va o‘z vaqtida sifatli bajarilishiga \u003cstrong\u003eilmiy loyiha mualliflari shaxsan javobgar\u003c/strong\u003e hisoblanadi.\u003c/p\u003e\u003cp\u003e✅ Loyihalarni amalga oshirish bilan bog‘liq \u003cstrong\u003ebarcha xarajatlar davlat tomonidan to‘liq qoplab beriladi.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eTanlovga taqdim etiladigan loyihalar \u003cstrong\u003eVazirlar Mahkamasining 2021-yil 19-apreldagi 222-son qaroriga ilova qilingan “Akademik harakatchanlik” dasturini shakllantirish, amalga oshirish, moliyalashtirish va monitoring qilish tartibi to‘g‘risidagi Nizom talablariga muvofiq\u003c/strong\u003e bo‘lishi shart.\u003c/p\u003e\u003cp\u003e📥 Loyihalar \u003cstrong\u003e10-martdan 30-martgacha\u003c/strong\u003e qabul qilinadi.\u003c/p\u003e\u003cp\u003e❇️ Bog‘lanish uchun: \u003cstrong\u003e(71) 203-32-23 (219)\u003c/strong\u003e.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"9:[\"$\",\"div\",null,{\"className\":\"container mx-auto min-h-screen\",\"children\":[\"$\",\"div\",null,{\"className\":\"container mx-auto mt-6 sm:mt-12\",\"children\":[[\"$\",\"nav\",null,{\"className\":\"text-content-text mt-4 mb-4 flex flex-wrap items-center gap-2 text-xs sm:text-sm\",\"children\":[[\"$\",\"$L19\",null,{\"href\":\"/\",\"className\":\"text-primary whitespace-nowrap hover:underline\",\"children\":\"Bosh sahifa\"}],[\"$\",\"span\",null,{\"className\":\"text-gray-500\",\"children\":\"/\"}],[\"$\",\"$L19\",null,{\"href\":\"/contest\",\"className\":\"text-primary whitespace-nowrap hover:underline\",\"children\":\"Tanlovlar\"}],[\"$\",\"span\",null,{\"className\":\"text-gray-500\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-content-text line-clamp-1 break-all\",\"children\":\"\\\"Akademik harakatchanlik\\\" dasturi tanlovi (2026-1)\"}]]}],[\"$\",\"h1\",null,{\"className\":\"wrap-break-words mb-4 text-xl font-semibold text-gray-900 sm:mb-6 sm:text-2xl lg:text-3xl\",\"children\":\"\\\"Akademik harakatchanlik\\\" dasturi tanlovi (2026-1)\"}],[\"$\",\"div\",null,{\"className\":\"mb-5 flex flex-col items-stretch gap-6 lg:flex-row lg:gap-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex w-full shrink-0 flex-col lg:max-w-[45%] xl:max-w-[50%]\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-0 z-10 w-full overflow-hidden rounded-lg border-2 border-[#E0E0E0] lg:top-[calc(var(--header-offset,160px)+20px)] lg:max-h-[calc(100vh-100px)] lg:min-h-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative h-full min-h-60 w-full bg-black/5 sm:min-h-80 lg:min-h-100\",\"children\":[\"$\",\"$L1a\",null,{\"imageUrl\":\"https://storage.ilmiy.uz/mobilitybucket/tg_image_3966316749_3f9a149c.png\",\"altText\":\"\\\"Akademik harakatchanlik\\\" dasturi tanlovi (